{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Thyrion",
  "version": "0.2.18",
  "identifier": "com.thyrion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thyrion",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-only",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/plinky": "linux/plinky-alias.sh",
          "/usr/bin/plinky-desktop": "linux/plinky-alias.sh"
        },
        "conflicts": [
          "plinky"
        ],
        "replaces": [
          "plinky"
        ],
        "provides": [
          "plinky"
        ]
      },
      "rpm": {
        "files": {
          "/usr/bin/plinky": "linux/plinky-alias.sh",
          "/usr/bin/plinky-desktop": "linux/plinky-alias.sh"
        },
        "obsoletes": [
          "Plinky",
          "plinky"
        ]
      }
    }
  }
}
